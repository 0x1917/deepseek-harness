// Renovate: the upstream watcher for this image (it replaces opengym's scout.yml
// and Dependabot).
//
// Unlike a GITHUB_TOKEN-opened PR, a Renovate app PR triggers workflows, so the
// `build` (with its smoke test) and `lint` checks run on every bump before it can
// be merged. Merging a bump to master then builds and publishes through
// build.yml -> publish.yml.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  labels: ['dependencies'],
  // No standing Dependency Dashboard issue: pending updates arrive as PRs.
  dependencyDashboard: false,
  customManagers: [
    {
      // Upstream cuts no GitHub "latest" release (every release is a
      // prerelease), so the source of truth is its `dsh-v<version>` git tags.
      // The Dockerfile installs the npm package of the same version; build.yml
      // waits for npm to catch up with a fresh tag.
      customType: 'regex',
      description: 'DeepSeek Harness release pinned by ARG DSH_VERSION',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG DSH_VERSION=(?<currentValue>\\S+)'],
      depNameTemplate: 'deepseek-ai/deepseek-harness',
      datasourceTemplate: 'github-tags',
      extractVersionTemplate: '^dsh-v(?<version>.+)$',
      versioningTemplate: 'semver',
    },
    {
      // pnpm follows upstream exactly: the version is whatever the
      // packageManager field names at the dsh-v<DSH_VERSION> tag, so the match
      // captures DSH_VERSION as the lookup's packageName. A dsh bump's own PR
      // already carries the matching pnpm: upstream-sync.yml commits it.
      customType: 'regex',
      description: 'pnpm, pinned to the one upstream builds the shipped release with',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG DSH_VERSION=(?<packageName>\\S+)[\\s\\S]*?ARG PNPM_VERSION=(?<currentValue>\\S+)'],
      depNameTemplate: 'pnpm',
      datasourceTemplate: 'custom.upstream-pnpm',
      versioningTemplate: 'semver',
    },
  ],
  customDatasources: {
    'upstream-pnpm': {
      defaultRegistryUrlTemplate: 'https://raw.githubusercontent.com/deepseek-ai/deepseek-harness/dsh-v{{packageName}}/package.json',
      format: 'json',
      // packageManager reads `pnpm@<version>`, optionally with a `+sha...` hash.
      transformTemplates: ['{"releases": [{"version": $split($substringAfter(packageManager, "pnpm@"), "+")[0]}]}'],
    },
  },
  packageRules: [
    {
      matchDepNames: ['deepseek-ai/deepseek-harness'],
      // Every upstream version is a prerelease: without this, Renovate would
      // never propose one.
      ignoreUnstable: false,
      // rc builds are what upstream's npm `latest` channel carries; alphas are
      // not, so they are never proposed.
      allowedVersions: '!/-alpha\\./',
      commitMessageTopic: 'DeepSeek Harness',
      labels: ['dependencies', 'upstream'],
    },
    {
      matchDepNames: ['pnpm'],
      commitMessageTopic: 'pnpm',
      labels: ['dependencies', 'upstream'],
    },
    {
      // Pin the node base image by digest so base image fixes (Debian security
      // updates, Node patch releases) arrive as PRs. Merging one republishes the
      // same dsh version as a -r<n> rebuild. Batched weekly to limit churn.
      matchDatasources: ['docker'],
      pinDigests: true,
    },
    {
      // The node major follows upstream's CI, not Docker Hub: Renovate cannot
      // switch it from upstream's file without dropping the digest pin, so it
      // proposes none. upstream-sync.yml moves it, re-pinned, on the dsh
      // bump's PR, and lint (scripts/check-upstream-match.sh) backs that up.
      matchDatasources: ['docker'],
      matchDepNames: ['node'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    {
      matchDatasources: ['docker'],
      matchUpdateTypes: ['digest', 'pinDigest'],
      schedule: ['before 6am on monday'],
    },
    {
      // Actions pin by major tag; minor and patch land as one PR, majors stay separate.
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'github-actions',
    },
  ],
}
